{
	admin off
	persist_config off
	auto_https off
	# Open live streams must not hold a replaced site container; the page reconnects on its own.
	grace_period 2s
}

:8080 {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
	}

	handle /healthz {
		respond "ok" 200
	}

	handle /ingest/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy {$EXPLORER_SERVICE:service:8081}
	}

	# Never compressed: a compressing encoder holds events back until its buffer fills.
	handle /live/* {
		reverse_proxy {$EXPLORER_SERVICE:service:8081} {
			flush_interval -1
		}
	}

	# The service writes each data version once, under its own name, then points manifest.json at it.
	@version path_regexp ^/data/v[0-9]
	handle @version {
		encode zstd gzip
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /data/* {
		encode zstd gzip
		root * /srv
		header Cache-Control "no-cache"
		file_server
	}

	handle /_app/immutable/* {
		encode zstd gzip
		root * /srv/site
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		encode zstd gzip
		root * /srv/site
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
