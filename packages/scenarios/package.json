{
  "name": "@flax/scenarios",
  "version": "0.0.1",
  "description": "A Gherkin scenario library runner for every surface and environment of a product, with a coverage map and a persona dataset; your scenarios stay in your workspace",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/spice-labs-inc/flax",
    "directory": "packages/scenarios"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "bin": {
    "flax-scenarios": "./dist/cli.js"
  },
  "flax": "dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/run/strip-types-loader.mjs dist/run/",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1",
    "@flax/contract": "workspace:*",
    "@flax/core": "workspace:*",
    "imapflow": "2.2.8",
    "mailparser": "3.9.36",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "playwright": "^1.63.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@types/mailparser": "3.9.0",
    "@types/node": "^24.0.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
