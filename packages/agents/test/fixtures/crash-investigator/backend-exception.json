        "src/main/java/io/notesco/backend/service/RegionService.java": [
          "package io.notesco.backend.service;",
          "",
          "import java.util.Map;",
          "import java.util.Optional;",
          "",
          "import org.springframework.stereotype.Service;",
          "",
          "/** Which storage region a project of an org lives in. */",
          "@Service",
          "public class RegionService {",
          "  private final Map<String, String> regions;",
          "",
          "  public RegionService(Map<String, String> regions) {",
          "    this.regions = regions;",
          "  }",
          "",
          "  /** The org's region, or empty when it has none. */",
          "  public Optional<String> find(String orgId) {",
          "    return Optional.ofNullable(regions.get(orgId));",
          "  }",
          "",
          "  /**",
          "   * The org's region. An org created before regions existed has none; callers",
          "   * that create projects call this.",
          "   */",
          "  public String regionFor(String orgId) {",
          "    String region = regions.get(orgId);",
          "    if (region != null) {",
          "      return region;",
          "    }",
          "    throw new IllegalStateException(\"No region configured for org \" + orgId);",
          "  }",
          "}"
        ],
        "src/main/java/io/notesco/backend/service/ProjectService.java": [
          "package io.notesco.backend.service;",
          "",
          "import org.slf4j.Logger;",
          "import org.slf4j.LoggerFactory;",
          "import org.springframework.stereotype.Service;",
          "",
          "@Service",
          "public class ProjectService {",
          "  private static final Logger log = LoggerFactory.getLogger(ProjectService.class);",
          "  private final RegionService regions;",
          "  private final ProjectStore store;",
          "",
          "  public ProjectService(RegionService regions, ProjectStore store) {",
          "    this.regions = regions;",
          "    this.store = store;",
          "  }",
          "",
          "  public Project create(String orgId, String name) {",
          "    log.info(\"Creating project for org {}\", orgId);",
          "    try {",
          "      return store.insert(orgId, name, regionOf(orgId));",
          "    } catch (RuntimeException e) {",
          "      log.error(\"Project creation failed for org {}\", orgId, e);",
          "      throw e;",
          "    }",
          "  }",
          "",
          "  private String regionOf(String orgId) {",
          "    return regions.regionFor(orgId);",
          "  }",
          "}"
        ],
        "src/main/java/io/notesco/backend/web/ProjectController.java": [
          "package io.notesco.backend.web;",
          "",
          "import io.notesco.backend.service.Project;",
          "import io.notesco.backend.service.ProjectService;",
          "import org.springframework.web.bind.annotation.PostMapping;",
          "import org.springframework.web.bind.annotation.RestController;",
          "",
          "@RestController",
          "public class ProjectController {",
          "  private final ProjectService projects;",
          "",
          "  public ProjectController(ProjectService projects) {",
          "    this.projects = projects;",
          "  }",
          "",
          "  @PostMapping(\"/api/v1/orgs/{org}/projects\")",
          "  public Project create(String org, String name) {",
          "    return Async.run(() -> {",
          "      return projects.create(org, name);",
          "    });",
          "  }",
          "}"
        ]
      },
