{
  "name": "@flax/agents",
  "version": "0.0.1",
  "description": "Scheduled agents that run unattended on cheap models with code guardrails: the job kit, its checker, generator, runner and a reusable GitHub Action",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/spice-labs-inc/flax.git",
    "directory": "packages/agents"
  },
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "flax": "./bin/flax-agents.mjs",
  "bin": {
    "flax-agents": "./bin/flax-agents.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./tools-server/mapping": "./src/tools-server/mapping.ts",
    "./test/*": "./test/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && vitest run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "tsx src/generate/cli.ts",
    "new-job": "tsx src/new-job/cli.ts",
    "run-job": "tsx src/run-job/cli.ts",
    "check-output": "tsx src/output-check/cli.ts",
    "fetch-servers": "tsx src/tools-server/fetch-servers-cli.ts",
    "fetch-github-hosts": "tsx src/tools-server/fetch-github-hosts-cli.ts",
    "tools-smoke": "tsx src/tools-server/smoke-cli.ts",
    "net-check": "tsx src/net-check/cli.ts",
    "bundle-pi-plugin": "tsx src/pi-plugin/cli.ts",
    "box-release": "tsx src/box-release/cli.ts"
  },
  "dependencies": {
    "@flax/core": "workspace:*",
    "@kubernetes/client-node": "2.0.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@slack/web-api": "8.2.0",
    "@xterm/xterm": "5.5.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "0.28.2",
    "ffmpeg-static": "5.3.0",
    "imapflow": "2.5.8",
    "mailparser": "3.10.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/mailparser": "3.9.0",
    "@types/node": "^24.13.6",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "files": [
    "action.yml",
    "bin",
    "images/agent",
    "jobs",
    "schema",
    "src",
    "test/fake-*.ts",
    "test/helpers.ts",
    "test/legacy-steps.ts",
    "test/fixtures/gateway-tls",
    "test/fixtures/workspace",
    "tools",
    "workflows",
    "docs"
  ]
}
