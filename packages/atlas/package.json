{
  "name": "@flax/atlas",
  "version": "0.0.1",
  "description": "An architecture atlas of your repositories, written for people and coding agents: page template, maintenance rules, budgets, generated tables, a wiring pipeline and a 3D map",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/spice-labs-inc/flax",
    "directory": "packages/atlas"
  },
  "homepage": "https://github.com/spice-labs-inc/flax/tree/main/packages/atlas#readme",
  "bugs": "https://github.com/spice-labs-inc/flax/issues",
  "keywords": [
    "architecture",
    "atlas",
    "documentation",
    "coding-agents",
    "graph",
    "3d"
  ],
  "type": "module",
  "flax": "./dist/bin.js",
  "exports": {
    ".": "./dist/index.js",
    "./config": "./dist/config.js",
    "./markdown": "./dist/atlas/markdown.js",
    "./yaml": "./dist/atlas/yaml.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/app",
    "src/model",
    "prompts",
    "templates",
    "README.md"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "tsc -p .",
    "check": "tsc --noEmit -p . && tsc -p tsconfig.app.json",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@flax/core": "workspace:*",
    "d3-force-3d": "^3.0.5",
    "elkjs": "^0.12.0",
    "esbuild": "^0.28.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2"
  }
}
